# TaskFlow environment configuration (template).
# Copy to .env for local use. .env is gitignored; only this file is tracked.
# Docker Compose reads .env automatically. When running the binary directly,
# export these variables (or pass a JSON file with --config; the environment wins).

# --- Docker Compose (development) ---
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskflow
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- HTTP server ---
TASKFLOW_HTTP_HOST=0.0.0.0
TASKFLOW_HTTP_PORT=8080
TASKFLOW_HTTP_THREADS=2

# --- PostgreSQL (durable source of truth) ---
TASKFLOW_POSTGRES_HOST=localhost
TASKFLOW_POSTGRES_PORT=5432
TASKFLOW_POSTGRES_USER=taskflow
TASKFLOW_POSTGRES_PASSWORD=change-me
TASKFLOW_POSTGRES_DATABASE=taskflow
# libpq "options" string, e.g. -csearch_path=myschema (optional)
TASKFLOW_POSTGRES_OPTIONS=
TASKFLOW_POSTGRES_POOL_SIZE=8
TASKFLOW_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
TASKFLOW_POSTGRES_ACQUIRE_TIMEOUT_MS=5000

# --- Redis (fast coordination; rebuildable from PostgreSQL) ---
TASKFLOW_REDIS_HOST=localhost
TASKFLOW_REDIS_PORT=6379
# Leave empty when Redis has no password.
TASKFLOW_REDIS_PASSWORD=
TASKFLOW_REDIS_DATABASE=0
TASKFLOW_REDIS_POOL_SIZE=4
TASKFLOW_REDIS_CONNECT_TIMEOUT_MS=2000
TASKFLOW_REDIS_COMMAND_TIMEOUT_MS=2000
TASKFLOW_REDIS_ACQUIRE_TIMEOUT_MS=5000

# --- Logging ---
# level: trace|debug|info|warn|error|critical|off   format: text|json
TASKFLOW_LOG_LEVEL=info
TASKFLOW_LOG_FORMAT=text

# --- Application lifecycle ---
TASKFLOW_AUTO_MIGRATE=true
TASKFLOW_MIGRATIONS_DIR=migrations
# How long startup waits for PostgreSQL and Redis before failing.
TASKFLOW_STARTUP_TIMEOUT_SECONDS=30
# /health reports "shutting_down" for this long before the process exits.
TASKFLOW_SHUTDOWN_GRACE_MS=1000

# --- Tests only ---
# Port used by the in-process HTTP test (tests/http).
TASKFLOW_TEST_HTTP_PORT=18080
